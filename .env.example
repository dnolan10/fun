# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — Project Settings > API. Server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The Odds API — https://the-odds-api.com (free tier signup)
ODDS_API_KEY=

# SportRadar NCAAFB v7 — https://developer.sportradar.com (for AP rankings & team stats)
SPORTRADAR_API_KEY=
# "trial" or "production", matching your SportRadar key type. Defaults to trial if unset.
SPORTRADAR_ACCESS_LEVEL=trial

# Set to the exact URL you deploy to, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticates the scheduled score-sync cron job (see vercel.json) --
# any long random string. Generate one with: openssl rand -hex 32
CRON_SECRET=
